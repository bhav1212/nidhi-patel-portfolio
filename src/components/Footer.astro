---
import { profile, contact, links, cvUrl } from '../data/profile';
import { copy, localePath, type Lang } from '../i18n/content';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy[lang];
---

<footer class="footer">
  <div>© <span id="year">2026</span> {profile.fullName}</div>
  <nav class="footer-links" aria-label={t.footer.label}>
    <a href={cvUrl} download>{t.footer.resume}</a>
    <a href={`mailto:${contact.email}`}>{t.footer.email}</a>
    <a href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    <a href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    <a href={localePath(lang, '/datenschutz/')}>{t.footer.privacy}</a>
  </nav>
</footer>
